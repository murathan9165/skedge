{
  "name": "kenyon-class-schedule-planner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "next build",
    "data:import": "tsx scripts/courses/import-fall-2026.ts",
    "data:verify": "tsx scripts/courses/verify-fall-2026.ts",
    "dev": "next dev",
    "lint": "eslint .",
    "prebuild": "npm run data:verify",
    "schedule:install": "bash scripts/launchd/install.sh install",
    "schedule:status": "bash scripts/launchd/install.sh status",
    "schedule:uninstall": "bash scripts/launchd/install.sh uninstall",
    "serve": "serve out --listen 3000",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/react": "^0.5.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "cheerio": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "29.0.1",
    "serve": "14.2.6",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
