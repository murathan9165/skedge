<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for the local daily import. `npm run schedule:install` rewrites
  __SCRIPT__ and __LOG_DIR__ and writes the result to ~/Library/LaunchAgents/.
  Edit this file, not the installed copy, then re-run the installer.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.skedge.daily-import</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SCRIPT__</string>
    </array>

    <!-- 08:00 local time. launchd tracks wall-clock time, so this follows DST
         automatically -- unlike the GitHub Actions cron, which is UTC-only. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- If the Mac was asleep at 08:00, run once on the next wake rather than
         skipping the day entirely. -->
    <key>RunAtLoad</key>
    <false/>

    <!-- launchd starts with a minimal PATH; node and npm live in Homebrew. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
